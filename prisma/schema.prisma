generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLAIMANT
  REVIEWER
  ADMIN
}

enum PolicyStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ClaimStatus {
  SUBMITTED
  PROCESSING
  UNDER_REVIEW
  APPROVED
  DENIED
  CLOSED
}

enum DocumentProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AssessmentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum FindingType {
  MISSING_DOCUMENT
  POLICY_MISMATCH
  DUPLICATE
  INCONSISTENCY
  OTHER
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReviewDecision {
  APPROVE
  REJECT
  REQUEST_INFORMATION
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  role         UserRole
  passwordHash String

  claims  Claim[]
  reviews Review[] @relation("ReviewReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Policy {
  id           String       @id @default(uuid()) @db.Uuid
  policyNumber String       @unique
  policyType   String
  status       PolicyStatus @default(PENDING)
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date

  clauses PolicyClause[]
  claims  Claim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startDate, endDate])
}

model PolicyClause {
  id         String @id @default(uuid()) @db.Uuid
  policyId   String @db.Uuid
  clauseType String
  content    String

  policy   Policy    @relation(fields: [policyId], references: [id], onDelete: Cascade)
  findings Finding[]

  createdAt DateTime @default(now())

  @@index([policyId, clauseType])
}

model Claim {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @db.Uuid
  policyId         String      @db.Uuid
  claimNumber      String      @unique
  claimedAmount    Decimal     @db.Decimal(12, 2)
  status           ClaimStatus @default(SUBMITTED)
  workflowThreadId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  policy      Policy       @relation(fields: [policyId], references: [id], onDelete: Restrict)
  documents   Document[]
  assessments Assessment[]
  reviews     Review[]
  auditLogs   AuditLog[]

  @@index([userId, createdAt])
  @@index([policyId, status])
  @@index([status, createdAt])
  @@index([workflowThreadId])
}

model Document {
  id               String                   @id @default(uuid()) @db.Uuid
  claimId          String                   @db.Uuid
  documentType     String
  s3Key            String                   @unique
  processingStatus DocumentProcessingStatus @default(PENDING)

  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([claimId, processingStatus])
}

model Assessment {
  id            String           @id @default(uuid()) @db.Uuid
  claimId       String           @db.Uuid
  result        Json
  status        AssessmentStatus @default(PENDING)
  modelName     String
  promptVersion String
  tokenUsage    Json
  latencyMs     Int?

  claim     Claim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  findings  Finding[]
  createdAt DateTime  @default(now())

  @@index([claimId, status])
  @@index([modelName, promptVersion])
}

model Finding {
  id             String          @id @default(uuid()) @db.Uuid
  assessmentId   String          @db.Uuid
  findingType    FindingType
  severity       FindingSeverity
  explanation    String
  evidence       Json
  policyClauseId String?         @db.Uuid

  assessment   Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  policyClause PolicyClause? @relation(fields: [policyClauseId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())

  @@index([assessmentId, severity])
  @@index([policyClauseId])
}

model Review {
  id         String         @id @default(uuid()) @db.Uuid
  claimId    String         @db.Uuid
  reviewerId String         @db.Uuid
  decision   ReviewDecision
  comments   String?

  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  reviewer  User     @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([claimId, createdAt])
  @@index([reviewerId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  claimId   String   @db.Uuid
  action    String
  metadata  Json
  createdAt DateTime @default(now())

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, createdAt])
  @@index([action, createdAt])
}
